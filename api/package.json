{
  "name": "prediction-tracker-api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun --env-file=.env test tests",
    "seed": "bun run src/people/seed.ts",
    "seed-check": "bun run src/people/seed-check.ts",
    "interests": "bun run src/interests/interests.ts",
    "exposures": "bun run src/interests/exposures.ts",
    "wayback": "bun run src/evidence/wayback.ts",
    "sec": "bun run src/interests/sec.ts",
    "threads": "bun run src/claims/threads.ts",
    "calibrate": "bun run src/scoring/calibration.ts",
    "consistency": "bun run src/consistency/check.ts",
    "agent": "bun run src/claims/agent.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "verify": "bun run src/claims/verify.ts",
    "probe": "bun run src/tools/probe-search.ts",
    "cleanup": "bun run src/tools/cleanup.ts",
    "replay": "bun run src/tools/replay.ts",
    "refetch": "bun run src/evidence/refetch.ts",
    "batch": "bun run src/jobs/batch.ts",
    "remap": "bun run src/claims/remap-domains.ts",
    "merge-orgs": "bun run src/interests/merge-orgs.ts",
    "rescore": "bun run src/scoring/score.ts",
    "requote": "bun run src/claims/requote.ts",
    "portraits": "bun run src/people/portrait.ts",
    "worker": "bun run src/jobs/worker.ts",
    "enqueue": "bun run src/jobs/enqueue.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@elysiajs/cors": "1.2.0",
    "elysia": "1.2.25",
    "playwright": "^1.64.1",
    "postgres": "^3.4.9",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
