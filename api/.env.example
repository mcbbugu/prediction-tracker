# 接口、worker 和各脚本共用（bun --env-file=.env）。复制为 api/.env 后填写；不要提交 .env。

# —— 必填 ——
DATABASE_URL=postgres://prior:prior@127.0.0.1:5434/prior
PORT=3011
# 审核台、校准台的口令；生产环境至少 24 个字符
REVIEW_TOKEN=
# 火山方舟（模型和联网搜索）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_MODEL=ark-code-latest
# SEC 要求声明「名称 联系邮箱」，带空格要加引号
SEC_USER_AGENT="prediction-tracker you@example.com"

# —— 上线时设置 ——
# 生产环境设为 production：本机模式失效、口令长度受检查
NODE_ENV=
# 允许从浏览器调用接口的网站，逗号分隔；不设则对任意来源放行（仅限本机开发）
CORS_ORIGINS=
# 网站地址，用于 consult / MCP 返回的链接
SITE_URL=http://localhost:4321

# —— 本机模式：只用于未上线的本机网站，生产环境会被拒绝 ——
# AUTO_PUBLISH=1

# —— 可选 ——
# 抓取回退：经 Jina Reader 读取需要 JS 渲染的页面（不填则跳过这一级）
JINA_API_KEY=
# Wayback 存档：archive.org 账号的 S3 key（不填则用匿名提交，额度很小）
IA_ACCESS_KEY=
IA_SECRET_KEY=
# 限速与预算
AFP_DAILY_BUDGET=3000
ARK_SEARCH_GAP_MS=2000
ARK_CHAT_GAP_MS=700
ARK_SEARCH_AFP=5
ARK_BREAKER_STREAK=8
# 网站上按需分析的并发与每日上限
ANALYZE_MAX_RUNNING=2
ANALYZE_DAILY_LIMIT=30
# 按 IP 限流：只存加盐哈希，不存明文。生产环境换成一长串随机字符。
IP_HASH_SALT=change-me
# 设为 1 时，用 X-Forwarded-For 的第一个地址当客户 IP（前面有反向代理才开）
TRUST_PROXY=
